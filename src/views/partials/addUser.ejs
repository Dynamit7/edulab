<div class="modal-backdrop" id="addUserBackdrop">
  <div class="modal" id="addUserModal">
    <div class="modal-header">
      <h3 class="modal-title">Добавить пользователя</h3>
      <button class="modal-close" id="addUserClose" aria-label="Закрыть">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <form id="addUserForm" autocomplete="off">
      <div class="modal-body">

        <div class="form-row">
          <div class="form-field">
            <label>Имя <span class="req">*</span></label>
            <input type="text" name="name" placeholder="Иван Иванов" required />
          </div>
          <div class="form-field">
            <label>Логин <span class="req">*</span></label>
            <input type="text" name="login" placeholder="ivan_ivanov" required autocomplete="off" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label>Телефон <span class="req">*</span></label>
            <input type="text" name="phone_number" placeholder="+998901234567" required />
          </div>
          <div class="form-field">
            <label>Роль <span class="req">*</span></label>
            <select name="role" required id="addUserRoleSelect">
              <option value="" disabled selected>Выберите роль</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label>Email</label>
            <input type="email" name="email" placeholder="ivan@example.com" />
          </div>
          <div class="form-field">
            <label>Telegram</label>
            <input type="text" name="telegram_username" placeholder="@username" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label>Пароль <span class="req">*</span></label>
            <div class="field-wrap">
              <input type="password" name="password" placeholder="Минимум 6 символов" required minlength="6" id="addUserPassword" />
              <button type="button" class="toggle-btn" id="addUserPwToggle" aria-label="Показать пароль">
                <svg id="addUserEye" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="form-error" id="addUserError"></div>

      </div>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="addUserCancel">Отмена</button>
        <button type="submit" class="btn-primary" id="addUserSubmit">
          <span class="btn-text">Создать</span>
          <span class="btn-spinner"><span class="spinner-ring"></span></span>
        </button>
      </div>
    </form>
  </div>
</div>
