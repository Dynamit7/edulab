<div class="view-content">
  <div class="view-header">
    <h2>Расписание</h2>
  </div>

  <% const days = ['','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота','Воскресенье']; %>
  <% const grouped = {}; %>
  <% schedule.forEach(s => { if (!grouped[s.weekday]) grouped[s.weekday] = []; grouped[s.weekday].push(s); }); %>

  <% if (schedule.length === 0) { %>
  <div class="empty-state" style="padding:60px 0">
    <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>
    <p>Расписание не задано</p>
  </div>
  <% } else { %>
  <div class="schedule-week">
    <% Object.keys(grouped).sort().forEach(day => { %>
    <div class="panel" style="margin-bottom:16px">
      <div class="panel-header">
        <div class="panel-title"><%= days[day] %></div>
      </div>
      <ul class="schedule-list">
        <% grouped[day].forEach(s => { %>
        <li class="schedule-item">
          <div class="schedule-time"><%= s.start_time %> – <%= s.end_time %></div>
          <div class="schedule-info">
            <div class="schedule-group"><%= s.group_title %></div>
            <div class="schedule-meta"><%= s.discipline %> · <%= s.room %></div>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
