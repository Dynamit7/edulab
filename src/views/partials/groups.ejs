<div class="view-content">
  <div class="view-header">
    <% if (selectedGroup) { %>
    <button class="back-btn" onclick="navigate('groups')">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      Назад
    </button>
    <h2><%= selectedGroup.title %></h2>
    <% } else { %>
    <h2><% if (user.role === 5) { %>Мои группы<% } else { %>Группы<% } %></h2>
    <% } %>
  </div>

  <% if (selectedGroup) { %>
  <!-- Group detail view -->
  <div class="group-detail">
    <div class="group-detail-meta">
      <div class="meta-card">
        <div class="meta-label">Дисциплина</div>
        <div class="meta-value"><%= selectedGroup.discipline %></div>
      </div>
      <div class="meta-card">
        <div class="meta-label">Учитель</div>
        <div class="meta-value"><%= selectedGroup.teacher_name %></div>
      </div>
      <div class="meta-card">
        <div class="meta-label">Филиал</div>
        <div class="meta-value"><%= selectedGroup.branch %></div>
      </div>
      <div class="meta-card">
        <div class="meta-label">Студентов</div>
        <div class="meta-value"><%= students.length %></div>
      </div>
    </div>

    <% if (schedule.length > 0) { %>
    <div class="panel" style="margin-bottom:20px">
      <div class="panel-header"><div class="panel-title">Расписание группы</div></div>
      <ul class="schedule-list">
        <% const days = ['','Пн','Вт','Ср','Чт','Пт','Сб','Вс']; %>
        <% schedule.forEach(s => { %>
        <li class="schedule-item">
          <div class="schedule-time"><%= days[s.weekday] %> · <%= s.start_time %> – <%= s.end_time %></div>
          <div class="schedule-info">
            <div class="schedule-meta"><%= s.room %></div>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <div class="panel">
      <div class="panel-header"><div class="panel-title">Студенты</div></div>
      <% if (students.length === 0) { %>
      <div class="empty-state"><p>Студентов нет</p></div>
      <% } else { %>
      <ul class="students-list">
        <% students.forEach((s, i) => { %>
        <li class="student-item">
          <div class="student-num"><%= i + 1 %></div>
          <div class="student-avatar"><%= s.name.charAt(0).toUpperCase() %></div>
          <div class="student-info">
            <div class="student-name"><%= s.name %></div>
            <div class="student-meta"><%= s.phone_number %></div>
          </div>
          <div class="student-status <%= s.frozen_till ? 'frozen' : 'active' %>">
            <%= s.frozen_till ? 'Заморожен' : 'Активен' %>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </div>

  <% } else { %>
  <!-- Groups list -->
  <% if (groups.length === 0) { %>
  <div class="empty-state" style="padding:60px 0">
    <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>
    <p>Групп нет</p>
  </div>
  <% } else { %>
  <div class="groups-grid">
    <% groups.forEach(g => { %>
    <div class="group-card" onclick="navigate('groups/<%= g.id %>')">
      <div class="group-card-top">
        <div class="group-card-icon"><%= g.title.charAt(0).toUpperCase() %></div>
        <div class="group-card-status <%= g.status === 1 ? 'active' : 'inactive' %>">
          <%= g.status === 1 ? 'Активна' : 'Неактивна' %>
        </div>
      </div>
      <div class="group-card-title"><%= g.title %></div>
      <div class="group-card-meta"><%= g.discipline %></div>
      <div class="group-card-footer">
        <span>
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <%= g.teacher_name %>
        </span>
        <span>
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <%= g.student_count %> студ.
        </span>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
  <% } %>
</div>
