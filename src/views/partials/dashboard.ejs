<div class="view-content">
  <div class="greeting">
    <h1>Добро пожаловать, <span><%= user.name %></span></h1>
    <p>
      <% if (user.role === 5)  { %>Посмотрите свои группы и расписание на сегодня<% } %>
      <% if (user.role === 8)  { %>Ваши группы и расписание занятий<% } %>
      <% if (user.role === 10) { %>Обзор школы: группы, посещаемость, платежи<% } %>
      <% if (user.role >= 12)  { %>Полный обзор системы Edulab<% } %>
    </p>
  </div>

  <div class="stats-grid">
    <% if (user.role >= 10) { %>
    <div class="stat-card">
      <div class="stat-icon stat-icon--blue">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.totalStudents %></div>
        <div class="stat-label">Студентов</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--purple">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.totalTeachers %></div>
        <div class="stat-label">Учителей</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--green">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.activeGroups %></div>
        <div class="stat-label">Активных групп</div>
      </div>
    </div>
    <% } %>

    <% if (user.role >= 12) { %>
    <div class="stat-card">
      <div class="stat-icon stat-icon--yellow">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.monthRevenue.toLocaleString() %></div>
        <div class="stat-label">Доход за месяц</div>
      </div>
    </div>
    <% } %>

    <% if (user.role === 8) { %>
    <div class="stat-card">
      <div class="stat-icon stat-icon--blue">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.myGroups %></div>
        <div class="stat-label">Моих групп</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--green">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.myStudents %></div>
        <div class="stat-label">Моих студентов</div>
      </div>
    </div>
    <% } %>

    <% if (user.role === 5) { %>
    <div class="stat-card">
      <div class="stat-icon stat-icon--blue">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.myGroups %></div>
        <div class="stat-label">Моих групп</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon--<%= stats.balance >= 0 ? 'green' : 'red' %>">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
      </div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.balance.toLocaleString() %></div>
        <div class="stat-label">Баланс</div>
      </div>
    </div>
    <% } %>
  </div>

  <div class="panels-grid">
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Расписание на сегодня</div>
        <button class="panel-link" onclick="navigate('schedule')">Всё расписание →</button>
      </div>
      <% if (todaySchedule.length === 0) { %>
      <div class="empty-state">
        <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p>Сегодня занятий нет</p>
      </div>
      <% } else { %>
      <ul class="schedule-list">
        <% todaySchedule.forEach(item => { %>
        <li class="schedule-item">
          <div class="schedule-time"><%= item.start_time %> – <%= item.end_time %></div>
          <div class="schedule-info">
            <div class="schedule-group"><%= item.group_title %></div>
            <div class="schedule-meta"><%= item.discipline %> · <%= item.room %></div>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <% if (user.role >= 10) { %>
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Последние действия</div>
        <% if (user.role >= 15) { %><button class="panel-link" onclick="navigate('audit')">Аудит лог →</button><% } %>
      </div>
      <% if (recentActivity.length === 0) { %>
      <div class="empty-state">
        <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p>Нет записей</p>
      </div>
      <% } else { %>
      <ul class="activity-list">
        <% recentActivity.forEach(item => { %>
        <li class="activity-item">
          <div class="activity-dot op-<%= item.operation %>"></div>
          <div class="activity-info">
            <div class="activity-text"><%= item.operation %> в <strong><%= item.table_name %></strong></div>
            <div class="activity-meta"><%= item.changed_by_name %> · <%= item.changed_at %></div>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <% } %>

    <% if (user.role === 5) { %>
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Моя посещаемость</div>
        <button class="panel-link" onclick="navigate('attendance')">Подробнее →</button>
      </div>
      <% if (myAttendance.length === 0) { %>
      <div class="empty-state">
        <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
        <p>Данных пока нет</p>
      </div>
      <% } else { %>
      <ul class="attendance-list">
        <% myAttendance.forEach(item => { %>
        <li class="attendance-item">
          <span class="attendance-date"><%= item.visit_date %></span>
          <span class="attendance-group"><%= item.group_title %></span>
          <span class="attendance-mark">✓</span>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <% } %>

    <% if (user.role === 8) { %>
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Посещаемость групп</div>
        <button class="panel-link" onclick="navigate('attendance')">Подробнее →</button>
      </div>
      <% if (groupAttendance.length === 0) { %>
      <div class="empty-state">
        <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p>Нет данных</p>
      </div>
      <% } else { %>
      <ul class="group-attendance-list">
        <% groupAttendance.forEach(g => { %>
        <li class="group-att-item">
          <div class="group-att-name"><%= g.title %></div>
          <div class="group-att-bar">
            <div class="group-att-fill" style="width:<%= g.percent %>%"></div>
          </div>
          <div class="group-att-pct"><%= g.percent %>%</div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
