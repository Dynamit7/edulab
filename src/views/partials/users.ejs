<div class="view-content">
  <div class="view-header">
    <h2>Пользователи</h2>
    <div class="view-header-count" id="usersCount"></div>
  </div>

  <div class="users-table-wrap">
    <table class="users-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Пользователь</th>
          <th>Логин</th>
          <th>Телефон</th>
          <th>Email</th>
          <th>Роль</th>
          <th>Статус</th>
          <th>Дата регистрации</th>
        </tr>
      </thead>
      <tbody id="usersBody">
        <tr id="usersLoadingRow">
          <td colspan="8" class="table-loading">
            <div class="spinner" style="margin:0 auto"></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="load-more-wrap" id="loadMoreWrap" style="display:none">
    <button class="btn-load-more" id="loadMoreBtn">Загрузить ещё</button>
  </div>
</div>

<script>
(function () {
  const ROLE_LABELS  = { 15: "Root", 12: "Admin", 10: "Supervisor", 8: "Teacher", 5: "Student" };
  const body         = document.getElementById("usersBody");
  const loadMoreWrap = document.getElementById("loadMoreWrap");
  const loadMoreBtn  = document.getElementById("loadMoreBtn");
  const countEl      = document.getElementById("usersCount");

  let totalLoaded = 0;

  function row(u, index) {
    const date = new Date(u.created_at).toLocaleDateString("ru-RU");
    const role = ROLE_LABELS[u.role] ?? "Unknown";
    const status = u.status === 1 ? '<span class="status-badge status-1">Активен</span>'
                                  : '<span class="status-badge status-0">Заблокирован</span>';
    return `<tr>
      <td class="text-muted">${index}</td>
      <td>
        <div class="user-cell">
          <div class="user-avatar sm">${u.name.charAt(0).toUpperCase()}</div>
          <span>${u.name}</span>
        </div>
      </td>
      <td class="text-muted">${u.login || '—'}</td>
      <td class="text-muted">${u.phone_number}</td>
      <td class="text-muted">${u.email || '—'}</td>
      <td><span class="role-badge role-${u.role}">${role}</span></td>
      <td>${status}</td>
      <td class="text-muted">${date}</td>
    </tr>`;
  }

  async function loadUsers(cursor) {
    try {
      const res  = await fetch(`/getAllUsers?cursor=${cursor}`);
      if (!res.ok) throw new Error(res.status);
      const data = await res.json();

      // Remove loading row on first load
      const loadingRow = document.getElementById("usersLoadingRow");
      if (loadingRow) loadingRow.remove();

      if (data.users.length === 0 && totalLoaded === 0) {
        body.innerHTML = '<tr><td colspan="8" class="table-empty">Пользователей нет</td></tr>';
        return;
      }

      const html = data.users.map((u, i) => row(u, totalLoaded + i + 1)).join("");
      body.insertAdjacentHTML("beforeend", html);
      totalLoaded += data.users.length;
      countEl.textContent = `${totalLoaded} польз.`;

      if (data.nextCursor) {
        loadMoreWrap.style.display = "flex";
        loadMoreBtn.dataset.cursor = data.nextCursor;
      } else {
        loadMoreWrap.style.display = "none";
      }
    } catch (err) {
      const loadingRow = document.getElementById("usersLoadingRow");
      if (loadingRow) loadingRow.remove();
      body.innerHTML = `<tr><td colspan="8" class="table-empty">Ошибка загрузки (${err.message})</td></tr>`;
    }
  }

  loadMoreBtn.addEventListener("click", async () => {
    const cursor = loadMoreBtn.dataset.cursor;
    loadMoreBtn.textContent = "Загрузка...";
    loadMoreBtn.disabled = true;
    await loadUsers(cursor);
    loadMoreBtn.textContent = "Загрузить ещё";
    loadMoreBtn.disabled = false;
  });

  // Initial load
  loadUsers(0);
})();
</script>
