<div class="view-content">
  <div class="view-header">
    <h2>Посещаемость</h2>
  </div>

  <% if (user.role === 5) { %>
  <div class="panel">
    <div class="panel-header"><div class="panel-title">История посещений</div></div>
    <% if (attendance.length === 0) { %>
    <div class="empty-state"><p>Записей нет</p></div>
    <% } else { %>
    <ul class="attendance-list">
      <% attendance.forEach(a => { %>
      <li class="attendance-item">
        <span class="attendance-date"><%= a.visit_date %></span>
        <span class="attendance-group"><%= a.group_title %></span>
        <span class="attendance-mark">✓</span>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>

  <% } else { %>
  <% if (groups.length === 0) { %>
  <div class="empty-state" style="padding:60px 0"><p>Нет данных</p></div>
  <% } else { %>
  <div class="panels-grid">
    <% groups.forEach(g => { %>
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title"><%= g.title %></div>
        <div class="panel-link"><%= g.percent %>%</div>
      </div>
      <div style="padding:12px 20px 16px">
        <div class="group-att-bar" style="height:8px">
          <div class="group-att-fill" style="width:<%= g.percent %>%"></div>
        </div>
        <div style="margin-top:8px;font-size:12px;color:rgba(255,255,255,0.4)">
          <%= g.visited %> / <%= g.total %> посещений за 30 дней
        </div>
      </div>
      <% if (g.recent.length > 0) { %>
      <ul class="attendance-list" style="border-top:1px solid rgba(255,255,255,0.06)">
        <% g.recent.forEach(a => { %>
        <li class="attendance-item">
          <span class="attendance-date"><%= a.visit_date %></span>
          <span class="attendance-group"><%= a.student_name %></span>
          <span class="attendance-mark">✓</span>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
  <% } %>
</div>
